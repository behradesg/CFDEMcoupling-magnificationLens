recModel standardRecModel;

recNorm sqrDiffNorm;

recPath simpleRandomPath;

volScalarFields
(
    voidfractionMean
);

volVectorFields
(
    UsMean
);

surfaceScalarFields
(
);

//verbose;

couplingSubStep 3;



// sub-model properties

