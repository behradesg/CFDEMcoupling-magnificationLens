FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      probesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fields
(
    voidfraction
    Us
);

writeControl   timeStep;
writeInterval  20;


// Locations to be probed.
probeLocations
(
    ( 0.00 0.0 0.05)
    ( 0.00 0.0 0.10)
    ( 0.00 0.0 0.15)
    ( 0.05 0.0 0.05)
    ( 0.05 0.0 0.10)
    ( 0.05 0.0 0.15)
    (-0.05 0.0 0.05)
    (-0.05 0.0 0.10)
    (-0.05 0.0 0.15)
);

