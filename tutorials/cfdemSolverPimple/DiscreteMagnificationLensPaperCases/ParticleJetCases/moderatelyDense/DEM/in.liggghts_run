################################################################################
# brief: CFD-DEM script for particle jet simulations                           #
#                                                                              #
# Cf. Esgandari et al. (2024), Discrete magnification lens model:              #
# A new hybrid multi-scale modelling method for fluid-particle systems,        #
# pow. tech.                                                                   #
#                                                                              #
# authors: Behrad Esgandari                                                    #
# date: Jan 2025                                                               #
# copyright: 2025- JKU Linz                                                    #
################################################################################


log             ../DEM/log.liggghts
thermo_log      ../DEM/post/thermo.txt

# define the attributes associated with the particles,
# 'granular' (or 'sphere') style uses diameter, mass and angular velocity
atom_style      granular

# use an array to map particle IDs to local storage index,
atom_modify     map array

# set simulation domain to be fixed in x y z
boundary        f p f

# save communication by turning off Newton's 3rd law for pairwise interaction,
# note: this setting only influences communication between procs, Newton's
# 3rd law is still used for contact force calculations
newton          off

# use a single value for ghost particle cutoff distance and
# enable velocity to be communicated with ghost particles
communicate     single vel yes

# set unit system to SI
units           si

# specify domain decomposition for parallel execution
processors      1 1 8

# define the region used as simulation domain (min/max X, min/max Y, min/max Z)
region          domain block -0.05 0.15 0.00 0.09 0.0 0.18 units box

# create the simulation domain and 1 material type for particle
create_box      2 domain

# specify the skin distance for neighbor list generation
neighbor        0.0003 bin
neigh_modify    delay 0

# define the material properties required for granular pair styles
# type 1 = particles / walls with friction
# type 2 = walls
fix m1 all property/global youngsModulus peratomtype 5e7 5e7
fix m2 all property/global poissonsRatio peratomtype 0.3 0.3
fix m3 all property/global coefficientRestitution peratomtypepair 2 0.8 0.95 0.95 0.95
fix m4 all property/global coefficientFriction peratomtypepair 2 0.05 0.05 0.05 0.05

# specify contact model to use
pair_style  gran model hertz tangential incremental_history
pair_coeff  * *

# set the time step
timestep    0.0000001

# apply gravity
fix gravity all gravity 0.0 vector 0.0 0.0 -1.0

# define walls
fix leftWallSTL all mesh/surface file ../DEM/meshes/wallLeft.stl type 2 
fix rightWallSTL all mesh/surface file ../DEM/meshes/wallRight.stl type 2 
fix walls all wall/gran model hertz tangential incremental_history mesh n_meshes 2 meshes leftWallSTL rightWallSTL

# insertion
fix insFaceLeft all mesh/surface/planar file ../DEM/meshes/insertionLeft.stl type 2
fix insFaceRight all mesh/surface/planar file ../DEM/meshes/insertionRight.stl type 2

fix pts1 all particletemplate/sphere 5330 atom_type 1 density constant 1000 radius constant 0.001
fix pdd1 all particledistribution/discrete 5331  1 pts1 1.0

fix insLeft all insert/stream seed 100001 distributiontemplate pdd1 nparticles 3666929 massrate 0.76 vel constant 10. 0. 10. &
                        insert_every 10000 overlapcheck yes all_in yes insertion_face insFaceLeft
                        
fix insRight all insert/stream seed 100001 distributiontemplate pdd1 nparticles 3666929 massrate 0.76 vel constant -10. 0. 10. &
                        insert_every 10000 overlapcheck yes all_in yes insertion_face insFaceRight

# set up coupling to CFD simulation
fix cfd  all couple/cfd couple_every 50 mpi
fix cfd2 all couple/cfd/force/implicit

# use constant NVE integration to update position, velocity and angular velocity
fix         integr all nve/sphere
fix ts_check all check/timestep/gran 10 0.1 0.1


# output settings, include kinetic energy
thermo_style    custom step atoms ke

# set frequency of output
thermo          1000

# ignore particles leaving the simulation domain,
# do not normalize thermodynamic output values by the number of atoms
thermo_modify   lost ignore norm no
compute_modify  thermo_temp dynamic yes

# output particle properties (same frequency as CFD output)
dump dmp all custom/vtk 100000 ../DEM/post/liggghts_run_*.vtk id type x y z vx vy vz &
     fx fy fz omegax omegay omegaz radius

# run 1 time step to initialize all DEM systems
run 1
