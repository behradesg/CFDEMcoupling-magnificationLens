FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

		
// Patches to create.

patches
(
    {
        name InletSolidLeft;  // Name of new patch to be created 
        patchInfo
        {
           type patch;    
        }
        constructFrom set;    
        set inletFaceSetLeft;  // name of the set created in topoSet 
    }
    
    {
        name InletSolidRight;  // Name of new patch to be created 
        patchInfo
        {
           type patch;    
        }
        constructFrom set;    
        set inletFaceSetRight;  // name of the set created in topoSet 
    }    
);

